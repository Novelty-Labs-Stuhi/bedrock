{
  "name": "bedrock",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "A markdown vault whose graph is the place you work — spatial, durable, plain files.",
  "main": "electron/main.cjs",
  "bin": {
    "bedrock": "bin/bedrock"
  },
  "files": [
    "bin",
    "dist",
    "electron"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "start": "npm run build && electron .",
    "app": "electron .",
    "package": "npm run build && electron-builder --mac dmg",
    "package:mac": "npm run build && set -a && . ./.env && set +a && electron-builder --mac dmg",
    "prepare": "npm run build"
  },
  "build": {
    "appId": "dev.getbedrock.app",
    "productName": "Bedrock",
    "directories": {
      "output": "release"
    },
    "afterAllArtifactBuild": "scripts/notarize-dmg.cjs",
    "files": [
      "dist/**",
      "electron/**",
      "package.json",
      "node_modules/node-pty/**"
    ],
    "asarUnpack": [
      "node_modules/node-pty/**"
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "identity": "Parasition AB (4Q45TL2D7B)",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "notarize": true
    }
  },
  "dependencies": {
    "@codemirror/commands": "^6.10.4",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.7",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "cytoscape": "^3.30.2",
    "cytoscape-cola": "^2.5.1",
    "node-pty": "^1.1.0"
  },
  "devDependencies": {
    "@types/cytoscape": "^3.21.9",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  }
}
