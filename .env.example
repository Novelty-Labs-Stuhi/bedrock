# Notarization credentials. Copy to .env and fill in — .env is gitignored.
#
# APPLE_ID                     the Apple ID on the Parasition AB team
# APPLE_APP_SPECIFIC_PASSWORD  from account.apple.com -> Sign-In and Security ->
#                              App-Specific Passwords. Format: abcd-efgh-ijkl-mnop.
#                              NOT the Apple ID's real password.
#
# The signing certificate is not configured here — it lives in the login keychain
# and codesign picks it up by name. Team ID is pinned in package.json.
#
# GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET
#                              the "Desktop app" OAuth client the Google Tasks
#                              integration signs in with (Google Cloud console ->
#                              Google Auth Platform -> Clients). `npm run build`
#                              writes them to electron/google-client.json, which is
#                              gitignored; a build without them has no client, and
#                              can only link over a client the person pastes in
#                              Settings. In CI they come from the repository's
#                              Actions secrets of the same names.

APPLE_ID=
APPLE_APP_SPECIFIC_PASSWORD=
APPLE_TEAM_ID=4Q45TL2D7B
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
